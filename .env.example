# ── Ace Peptides — environment variables ───────────────────────────────────
# Copy to .env.local for local dev (run the API with `vercel dev`), and set the
# same in Vercel → Project → Settings → Environment Variables for Preview + Prod.

# ── Database (Supabase) — REQUIRED ─────────────────────────────────────────
# Project URL + SERVICE ROLE key (server-only; bypasses RLS — never expose it).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Anon/public key — REQUIRED for public endpoints (api/stock.js, api/validate-code.js).
# Find it in Supabase → Project Settings → API → anon public.
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Transactional email (Resend) — order confirmations ─────────────────────
# Without these, orders still save; confirmation emails are skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
ORDER_EMAIL=orders@yourdomain.com          # operator inbox for new-order alerts
EMAIL_FROM=onboarding@resend.dev           # a verified Resend sender (optional)

# ── Admin dashboard (/admin) — REQUIRED ────────────────────────────────────
# Used for the admin password. Must be a random string of at least 32 characters.
ADMIN_SECRET=use-a-long-random-string-min-32-characters
# Separate HMAC signing key for session tokens. Use a different random value.
TOKEN_SIGNING_SECRET=use-a-different-long-random-string-for-token-signing

# ── On-chain payment verification — REQUIRED to enforce verification ───────
# Mainnet JSON-RPC URL (Alchemy / Infura / QuickNode). Without it, all payments
# are held 'pending' and must be manually verified or reconciled by the cron.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-KEY
# Minimum on-chain confirmations before a payment is accepted as verified (default 12).
CONFIRMATION_DEPTH=12
# Wallet that receives payments. Must match RECIPIENT_ADDRESS in src/App.js —
# the client sends funds to its hardcoded address, the server verifies against
# this one; if they differ every payment is rejected as a mismatch.
RECIPIENT_ADDRESS=0xEC6d18a2CbdCdabFEbA54ADecc616Df5e7e79dBa

# ── Cron (payment reconciliation) — REQUIRED for /api/cron/verify-orders ───
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to scheduled runs.
CRON_SECRET=use-another-long-random-string

# ── Client kill switch (optional, build-time) ──────────────────────────────
# "true" shows a "temporarily unavailable" page instead of the storefront.
REACT_APP_KILL_SWITCH=false
